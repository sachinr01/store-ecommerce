<!-- ─── MEDIA MODAL ──────────────────────────────────────────────────── -->
<div class="modal fade" id="mediaModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">

      <!-- Header: tabs + close -->
      <div class="modal-header py-2 border-bottom">
        <ul class="nav nav-tabs border-0 mb-0 gap-1">
          <li class="nav-item">
            <a class="nav-link px-3 py-2 active" id="mediaTabLibraryLink" href="#"
              onclick="showMediaTab('library');return false;">Media Library</a>
          </li>
          <li class="nav-item">
            <a class="nav-link px-3 py-2" id="mediaTabUploadLink" href="#"
              onclick="showMediaTab('upload');return false;">Upload Files</a>
          </li>
        </ul>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
      </div>

      <!-- WordPress-style toolbar (Library tab only) -->
      <div id="mediaToolbar" class="border-bottom px-3 py-2 bg-light d-flex align-items-center gap-2 flex-wrap">

        <!-- Select-all checkbox -->
        <div class="form-check mb-0 me-1" title="Select all">
          <input class="form-check-input" type="checkbox" id="mediaSelectAll" style="width:16px;height:16px;">
        </div>

        <!-- Bulk action dropdown -->
        <select id="mediaBulkSelect" class="form-select form-select-sm" style="width:150px;">
          <option value="">Bulk Actions</option>
          <option value="delete">Delete Permanently</option>
        </select>
        <button class="btn btn-secondary btn-sm rounded-1 px-3" onclick="mediaApplyBulk()">Apply</button>

        <div class="vr" style="height:22px;"></div>

        <!-- Selected count -->
        <span id="mediaSelCount" class="text-muted small">0 selected</span>

        <!-- Delete-selected shortcut button (shows when something is checked) -->
        <button id="mediaBtnDeleteSel" class="btn btn-danger btn-sm rounded-1 px-3 d-none"
          onclick="mediaDeleteSelected()">
          <i data-feather="trash-2" style="width:13px;height:13px;display:inline-block;vertical-align:middle;" class="me-1"></i>Delete Selected
        </button>

        <!-- Alert inside toolbar -->
        <div id="mediaAlert" class="alert mb-0 py-1 px-3 d-none align-items-center gap-2"
          style="font-size:12.5px;max-width:340px;" role="alert">
          <i id="mediaAlertIcon" data-feather="info" style="width:14px;height:14px;flex-shrink:0;"></i>
          <span id="mediaAlertMsg"></span>
          <button type="button" class="btn-close btn-close ms-1 p-0" style="font-size:10px;"
            onclick="mediaHideAlert()"></button>
        </div>

        <!-- Quick-access buttons (mirrored from footer) -->
        <div class="d-flex align-items-center gap-2 ms-auto">
          <button type="button" class="btn btn-secondary rounded-pill px-3 py-1" style="font-size:13px;" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary rounded-pill px-3 py-1" style="font-size:13px;" id="btnInsertMediaToolbar" disabled
            onclick="insertSelectedMedia()">Insert Selected</button>
        </div>

      </div>

      <div class="modal-body p-0" style="min-height:500px;">
        <div class="d-flex h-100">

          <!-- LEFT: grid -->
          <div class="flex-grow-1 p-3" style="overflow-y:auto;">

            <!-- Library Tab -->
            <div id="mediaLibraryTab">
              <div id="mediaGrid" class="d-flex flex-wrap gap-3" style="padding:14px 10px 6px;"></div>
              <div id="mediaPaginationBox" class="d-flex justify-content-center align-items-center gap-1 flex-wrap py-3"></div>
            </div>

            <!-- Upload Tab -->
            <div id="mediaUploadTab" style="display:none;" class="py-4 text-center">
              <div class="border rounded p-5 bg-light">
                <i class="mb-3 d-block" style="font-size:40px;">📁</i>
                <p class="mb-3 text-muted">Drop files here or click to select</p>
                <input type="file" id="mediaUploadInput" multiple accept="image/*" class="form-control mb-3" />
                <button class="btn btn-primary rounded-pill px-4" onclick="uploadMedia()">Upload</button>
              </div>
            </div>

          </div>

          <!-- RIGHT: selected image details -->
          <div id="selectedMediaInfo" class="border-start p-3 bg-light" style="width:280px;min-width:220px;display:none;">
            <img id="selectedMediaPreview" src="" class="img-fluid rounded mb-3 border d-block mx-auto"
              style="max-height:160px;object-fit:contain;" />
            <div class="mb-2">
              <label class="form-label small fw-semibold mb-1">Title</label>
              <input type="text" id="selectedMediaTitle" class="form-control form-control-sm" placeholder="Image title" />
            </div>
            <div class="mb-3">
              <label class="form-label small fw-semibold mb-1">Alt Text</label>
              <input type="text" id="selectedMediaAlt" class="form-control form-control-sm" placeholder="Alt text" />
            </div>
            <!-- Delete this image button -->
            <button class="btn btn-outline-danger btn-sm w-100 rounded-1 mt-1" onclick="mediaDeleteCurrentSingle()">
              <i data-feather="trash-2" style="width:13px;height:13px;display:inline-block;vertical-align:middle;" class="me-1"></i>
              Delete Permanently
            </button>
          </div>

        </div>
      </div>



    </div>
  </div>
</div>
<!-- /MEDIA MODAL -->

<!-- ─── Delete Confirm Modal (used by media picker) ────────────────────── -->
<div class="modal fade" id="mediaConfirmDeleteModal" tabindex="-1" aria-hidden="true" style="z-index:1060;">
  <div class="modal-dialog modal-dialog-centered" style="max-width:420px;">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-body p-4 text-center">
        <div class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-3"
          style="width:56px;height:56px;">
          <i data-feather="trash-2" class="text-danger" style="width:26px;height:26px;"></i>
        </div>
        <h5 class="fw-semibold mb-1">Delete Permanently?</h5>
        <p id="mediaConfirmDeleteMsg" class="text-muted mb-3" style="font-size:13.5px;"></p>
        <div id="mediaConfirmDeleteStrip" class="d-flex flex-wrap justify-content-center gap-1 mb-3"></div>
        <div class="d-flex gap-2 justify-content-center">
          <button class="btn btn-outline-secondary rounded-pill px-4"
            onclick="bootstrap.Modal.getInstance(document.getElementById('mediaConfirmDeleteModal')).hide()">Cancel</button>
          <button class="btn btn-danger rounded-pill px-4" id="mediaConfirmDeleteBtn"
            onclick="mediaExecuteDelete()">
            <i data-feather="trash-2" style="width:13px;height:13px;" class="me-1"></i>Delete
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- /Delete Confirm Modal -->
