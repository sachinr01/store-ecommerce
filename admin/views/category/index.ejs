<%- include('../partials/head') %>

  <%- include('../partials/navbar') %>
    <%- include('../partials/sidebar') %>

      <div class="page-wrapper">

        <!-- ── Breadcrumb ── -->
        <div class="page-breadcrumb">
          <div class="row">
            <div class="col-7 align-self-center">
              <h4 class="page-title">Categories</h4>
              <div class="d-flex align-items-center">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="/admin/products">Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Categories</li>
                  </ol>
                </nav>
              </div>
            </div>
            <div class="col-5 align-self-center text-end">
              <span class="btn-view-product btn-view-product--inline na-view-all-btn">
                <i data-feather="tag" class="feather-sm me-1"></i>
                <%= categories.length %> Total
              </span>
            </div>
          </div>
        </div>

        <div class="container-fluid">

          <!-- Flash messages -->

          <% if (locals.errors) { %>
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2">
              <i data-feather="alert-circle" class="feather-sm flex-shrink-0"></i>
              <%= locals.errors %>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
            <% } %>

              <div class="row">

                <!-- ══════════════════════════════════════════════
           LEFT COL — Add Category
      ══════════════════════════════════════════════ -->
                <div class="col-lg-4 col-md-5">
                  <div class="card mb-4">
                    <div class="card-body">

                      <h4 class="card-title mb-3 pb-3 border-bottom">Add New Category</h4>

                      <form method="POST" action="/admin/product/category">

                        <div class="mb-3">
                          <label class="form-label fw-semibold">
                            Name <span class="text-danger">*</span>
                          </label>
                          <input type="text" name="category_name" id="add_name" class="form-control"
                            placeholder="e.g. T-Shirts" required />
                          <div class="form-text">The name is how it appears on your site.</div>
                        </div>

                        <div class="mb-3">
                          <label class="form-label fw-semibold">Slug</label>
                          <input type="text" name="category_slug" id="add_slug" class="form-control"
                            placeholder="auto-generated-from-name" />
                          <div class="form-text">URL-friendly version. Leave blank to auto-generate.</div>
                        </div>

                        <div class="mb-3">
                          <label class="form-label fw-semibold">Parent Category</label>
                          <select name="parent_id" class="form-select">
                            <option value="0">— None (Top-level) —</option>
                            <% categories.forEach(c=> { %>
                              <option value="<%= c.category_id %>">
                                <%= c.category_name %>
                              </option>
                              <% }) %>
                          </select>
                          <div class="form-text">Categories can have a hierarchy.</div>
                        </div>

                        <div class="mb-3">
                          <label class="form-label fw-semibold">Description</label>
                          <textarea name="category_desc" class="form-control" rows="3"
                            placeholder="Optional category description..."></textarea>
                          <div class="form-text">Shown on some themes, not required.</div>
                        </div>

                        <!-- Category Image -->
                        <div class="mb-3">
                          <label class="form-label fw-semibold">Category Image</label>
                          <input type="hidden" name="category_image" id="add_category_image" value="">
                          <div class="border rounded p-3 text-center" id="add_cat_img_preview"
                            style="min-height:120px;cursor:pointer;"
                            onclick="openCatMedia('add')">
                            <div id="add_cat_img_inner">
                              <i data-feather="image" style="width:36px;height:36px;"
                                class="text-muted mb-2 d-block mx-auto"></i>
                              <p class="text-muted small mb-0">Click to select image</p>
                            </div>
                          </div>
                          <button type="button" id="add_cat_remove_btn"
                            class="btn btn-link btn-sm text-danger p-0 mt-1"
                            onclick="removeCatImage('add')" style="display:none;">
                            <i data-feather="trash-2" class="feather-sm me-1"></i> Remove image
                          </button>
                          <div class="mt-2 p-2 rounded-2 bg-light border d-flex align-items-center gap-2" style="font-size:12.5px;">
                            <i data-feather="info" style="width:13px;height:13px;flex-shrink:0;" class="text-primary"></i>
                            <span>Required size: 828 × 828 px</span>
                          </div>
                          <div id="add_cat_dim_msg" class="alert d-none py-2 px-3 mt-1 mb-0" role="alert" style="font-size:12.5px;"></div>
                        </div>

                        <div class="d-grid">
                          <button type="submit" class="btn-view-product btn-view-product--inline na-view-all-btn">
                            <div class="d-flex align-items-center justify-content-center gap-1">
                              <i data-feather="plus-circle" class="feather-sm"></i>
                              Add New Category
                            </div>
                          </button>
                        </div>

                      </form>
                    </div>
                  </div>
                </div>
                <!-- /LEFT -->


                <!-- ══════════════════════════════════════════════
           RIGHT COL — Category Table
      ══════════════════════════════════════════════ -->
                <div class="col-lg-8 col-md-7">
                  <div class="card mb-4">
                    <div class="card-body">

                      <!-- Table toolbar -->
                      <div
                        class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom flex-wrap gap-2">
                        <h4 class="card-title mb-0">Categories</h4>
                        <div class="d-flex align-items-center gap-2">
                          <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent">
                              <i data-feather="search" class="feather-sm text-muted"></i>
                            </span>
                            <input type="text" id="catSearch" class="form-control" placeholder="Search categories..."
                              oninput="filterCats()" />
                          </div>
                          <span class="badge bg-light text-dark border fw-normal" id="catCountLabel">
                            <%= categories.length %> items
                          </span>
                        </div>
                      </div>

                      <% if (categories.length===0) { %>

                        <!-- Empty state -->
                        <div class="text-center py-5 text-muted">
                          <i data-feather="tag" class="d-block mx-auto mb-3 opacity-25"
                            style="width:48px;height:48px;"></i>
                          <p class="fw-semibold mb-1">No categories yet</p>
                          <small>Add your first category using the form on the left.</small>
                        </div>

                        <% } else { %>

                          <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="catTable">
                              <thead class="table-light">
                                <tr>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem; width:60px;">Image</th>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem;">Name</th>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem;">Slug</th>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem;">Parent</th>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem;">Home</th>
                                  <th class="text-uppercase text-muted fw-semibold small"
                                    style="letter-spacing:.05em; font-size:.72rem;">Actions</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% categories.forEach(cat=> {
                                  const parentCat = categories.find(c => c.category_id === cat.parent_id);
                                  %>
                                  <tr>

                                    <!-- Image -->
                                    <td>
                                      <% if (cat.category_image) { %>
                                        <img src="<%= cat.category_image %>" alt="<%= cat.category_name %>"
                                          class="rounded" width="40" height="40" style="object-fit:cover;" />
                                      <% } else { %>
                                        <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                          style="width:40px;height:40px;">
                                          <i data-feather="image" class="text-muted" style="width:16px;height:16px;"></i>
                                        </div>
                                      <% } %>
                                    </td>

                                    <!-- Name + description -->
                                    <td>
                                      <div class="d-flex align-items-center gap-2">
                                        <div
                                          class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                          style="width:34px;height:34px;">
                                          <i data-feather="tag" class="text-primary"
                                            style="width:14px;height:14px;"></i>
                                        </div>
                                        <div class="overflow-hidden">
                                          <div class="fw-semibold text-dark lh-sm">
                                            <%= cat.category_name %>
                                          </div>
                                          <% if (cat.category_desc) { %>
                                            <div class="text-muted small text-truncate" style="max-width:160px;">
                                              <%= cat.category_desc %>
                                            </div>
                                            <% } %>
                                        </div>
                                      </div>
                                    </td>

                                    <!-- Slug -->
                                    <td>
                                      <code
                                        class="bg-light border rounded px-2 py-1 small text-secondary d-inline-block">
                            <%= cat.category_slug %>
                          </code>
                                    </td>

                                    <!-- Parent -->
                                    <td>
                                      <% if (parentCat) { %>
                                        <span
                                          class="badge bg-primary bg-opacity-10 text-primary fw-normal px-2 py-1 rounded-pill">
                                          <i data-feather="corner-down-right" style="width:11px;height:11px;"
                                            class="me-1"></i>
                                          <%= parentCat.category_name %>
                                        </span>
                                        <% } else { %>
                                          <span class="text-muted small">—</span>
                                          <% } %>
                                    </td>

                                    <!-- Show in Home toggle -->
                                    <td>
                                      <div class="form-check form-switch mb-0">
                                        <input class="form-check-input toggle-home" type="checkbox" role="switch"
                                          data-id="<%= cat.category_id %>"
                                          <%= cat.show_in_home ? 'checked' : '' %>>
                                        <label class="form-check-label home-label-<%= cat.category_id %> small text-muted">
                                          <%= cat.show_in_home ? 'Yes' : 'No' %>
                                        </label>
                                      </div>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                      <div class="d-flex align-items-center gap-1">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick='editCategory(
                                <%= cat.category_id %>,
                                "<%= cat.category_name.replace(/"/g, ' \\"') %>",
                                          "<%= cat.category_slug %>",
                                            "<%= cat.parent_id || 0 %>",
                                              "<%= (cat.category_desc || '' ).replace(/"/g, '\\"' ) %>",
                                                "<%= (cat.category_image || '').replace(/"/g, '\\"') %>"
                                                )'>
                                                <div class="d-flex align-items-center gap-1">
                                                  <i data-feather="edit-2" class="feather-sm"></i> Edit
                                                </div>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-btn"
                                          data-id="<%= cat.category_id %>" data-name="<%= cat.category_name %>"
                                          data-url="/admin/product/category/delete/" data-title="Delete Category">

                                          <div class="d-flex align-items-center gap-1">
                                            <i data-feather="trash-2" class="feather-sm"></i> Delete
                                          </div>
                                        </button>
                                      </div>
                                    </td>

                                  </tr>
                                  <% }) %>
                              </tbody>
                            </table>
                          </div>

                          <!-- Footer -->
                          <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <small class="text-muted" id="catFooterCount">
                              Showing <%= categories.length %> of <%= categories.length %> categories
                            </small>
                            <small class="text-muted d-flex align-items-center gap-1">
                              <i data-feather="info" class="feather-sm"></i>
                              Click <strong class="mx-1">Edit</strong> to modify a category
                            </small>
                          </div>

                          <% } %>

                    </div>
                  </div>
                </div>
                <!-- /RIGHT -->

              </div>
        </div>
      </div>
      <!-- /page-wrapper -->


      <!-- ══════════════════════════════════════════════
     EDIT MODAL
══════════════════════════════════════════════ -->
      <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
          <div class="modal-content">

            <div class="modal-header bg-light border-bottom">
              <div class="d-flex align-items-center gap-2">
                <div
                  class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                  style="width:34px;height:34px;">
                  <i data-feather="edit-2" class="text-warning" style="width:15px;height:15px;"></i>
                </div>
                <h5 class="modal-title mb-0 fw-semibold" id="editModalLabel">Edit Category</h5>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="editForm" method="POST">
              <input type="hidden" name="id" id="edit_id" />

              <div class="modal-body">

                <div class="mb-3">
                  <label class="form-label fw-semibold">
                    Name <span class="text-danger">*</span>
                  </label>
                  <input type="text" name="category_name" id="edit_name" class="form-control" required
                    placeholder="Category name" />
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Slug</label>
                  <input type="text" name="category_slug" id="edit_slug" class="form-control"
                    placeholder="url-friendly-slug" />
                  <div class="form-text">Leave blank to auto-generate from name.</div>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Parent Category</label>
                  <select name="parent_id" id="edit_parent" class="form-select">
                    <option value="0">— None (Top-level) —</option>
                    <% categories.forEach(c=> { %>
                      <option value="<%= c.category_id  %>">
                        <%= c.category_name %>
                      </option>
                      <% }) %>
                  </select>
                </div>

                <div class="mb-3">
                  <label class="form-label fw-semibold">Description</label>
                  <textarea name="category_desc" id="edit_desc" class="form-control" rows="3"
                    placeholder="Optional description..."></textarea>
                </div>

                <!-- Category Image -->
                <div class="mb-3">
                  <label class="form-label fw-semibold">Category Image</label>
                  <input type="hidden" name="category_image" id="edit_category_image" value="">
                  <div class="border rounded p-3 text-center" id="edit_cat_img_preview"
                    style="min-height:100px;cursor:pointer;"
                    onclick="openCatMedia('edit')">
                    <div id="edit_cat_img_inner">
                      <i data-feather="image" style="width:32px;height:32px;"
                        class="text-muted mb-1 d-block mx-auto"></i>
                      <p class="text-muted small mb-0">Click to select image</p>
                    </div>
                  </div>
                  <button type="button" id="edit_cat_remove_btn"
                    class="btn btn-link btn-sm text-danger p-0 mt-1"
                    onclick="removeCatImage('edit')" style="display:none;">
                    <i data-feather="trash-2" class="feather-sm me-1"></i> Remove image
                  </button>
                  <div class="mt-2 p-2 rounded-2 bg-light border d-flex align-items-center gap-2" style="font-size:12.5px;">
                    <i data-feather="info" style="width:13px;height:13px;flex-shrink:0;" class="text-primary"></i>
                    <span>Required size: 828 × 828 px</span>
                  </div>
                  <div id="edit_cat_dim_msg" class="alert d-none py-2 px-3 mt-1 mb-0" role="alert" style="font-size:12.5px;"></div>
                </div>

              </div>

              <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                  Cancel
                </button>
                <button type="submit" class="btn btn-success rounded-pill px-4">
                  <div class="d-flex align-items-center gap-1">
                    <i data-feather="save" class="feather-sm"></i>
                    Update Category
                  </div>
                </button>
              </div>

            </form>
          </div>
        </div>
      </div>


      <%- include('../partials/scripts') %>
        <script>
          // Auto-generate slug from name (add form)
          document.getElementById('add_name').addEventListener('input', function () {
            var slugField = document.getElementById('add_slug');
            if (!slugField.dataset.manual) {
              slugField.value = this.value
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-|-$/g, '');
            }
          });
          document.getElementById('add_slug').addEventListener('input', function () {
            this.dataset.manual = this.value ? '1' : '';
          });

          // Populate + show edit modal
          async function editCategory(id, name, slug, parent, desc, image) {
            document.getElementById('edit_id').value = id;
            document.getElementById('edit_name').value = name;
            document.getElementById('edit_slug').value = slug;
            document.getElementById('edit_parent').value = parent || 0;
            document.getElementById('edit_desc').value = desc;

            // Set image
            document.getElementById('edit_category_image').value = image || '';
            const inner = document.getElementById('edit_cat_img_inner');
            const removeBtn = document.getElementById('edit_cat_remove_btn');
            if (image) {
              inner.innerHTML = `<img src="${image}" class="img-fluid rounded" style="max-height:100px;">`;
              removeBtn.style.display = '';
              await validateCatDimensions(image, 'edit');
            } else {
              inner.innerHTML = `<i data-feather="image" style="width:32px;height:32px;" class="text-muted mb-1 d-block mx-auto"></i><p class="text-muted small mb-0">Click to select image</p>`;
              removeBtn.style.display = 'none';
              hideCatDimMsg('edit');
            }

            document.getElementById('editForm').action = '/admin/product/category/update/' + id;
            new bootstrap.Modal(document.getElementById('editModal')).show();
            feather.replace();
          }

          // ── Category image picker helpers ─────────────────────────────────
          // context = 'add' | 'edit'
          let _catMediaContext = null;

          const CAT_DIM = { w: 828, h: 828 };

          // Validate dimensions
          async function validateCatDimensions(url, context) {
            return new Promise((resolve) => {
              const img = new Image();
              img.onload = () => {
                const actual = { w: img.naturalWidth, h: img.naturalHeight };
                const el = document.getElementById(context + '_cat_dim_msg');
                if (!el) return resolve();

                if (actual.w === CAT_DIM.w && actual.h === CAT_DIM.h) {
                  el.classList.remove('d-none', 'alert-warning');
                  el.classList.add('alert-success');
                  el.innerHTML = `<i data-feather="check-circle" style="width:13px;height:13px;" class="me-1"></i>
                    Dimensions OK — <strong>${actual.w} × ${actual.h}px</strong>`;
                } else {
                  el.classList.remove('d-none', 'alert-success');
                  el.classList.add('alert-warning');
                  el.innerHTML = `<i data-feather="alert-triangle" style="width:13px;height:13px;" class="me-1"></i>
                    Image is <strong>${actual.w} × ${actual.h}px</strong> — expected <strong>${CAT_DIM.w} × ${CAT_DIM.h}px</strong>.
                    The image will still be saved but may not display correctly.`;
                }
                feather.replace();
                resolve();
              };
              img.onerror = () => resolve();
              img.src = url;
            });
          }

          function hideCatDimMsg(context) {
            const el = document.getElementById(context + '_cat_dim_msg');
            if (el) el.classList.add('d-none');
          }

          function openCatMedia(context) {
            _catMediaContext = context;
            openMedia({
              urlInput: context + '_category_image',
              preview:  context + '_cat_img_inner'
            });
          }

          function removeCatImage(context) {
            document.getElementById(context + '_category_image').value = '';
            const inner = document.getElementById(context + '_cat_img_inner');
            const prefix = context === 'add' ? '36px;height:36px' : '32px;height:32px';
            inner.innerHTML = `<i data-feather="image" style="width:${prefix};" class="text-muted mb-1 d-block mx-auto"></i><p class="text-muted small mb-0">Click to select image</p>`;
            document.getElementById(context + '_cat_remove_btn').style.display = 'none';
            hideCatDimMsg(context);
            feather.replace();
          }

          // Override insertSelectedMedia to handle category image preview + remove btn + dimension check
          const _origCatInsert = window.insertSelectedMedia;
          window.insertSelectedMedia = async function () {
            _origCatInsert && _origCatInsert();
            if (!_catMediaContext) return;
            const ctx = _catMediaContext;
            const url = document.getElementById(ctx + '_category_image').value;
            if (!url) return;
            document.getElementById(ctx + '_cat_remove_btn').style.display = '';
            await validateCatDimensions(url, ctx);
            _catMediaContext = null;
          };

          // Show-in-home toggles (AJAX)
          document.querySelectorAll('.toggle-home').forEach(toggle => {
            toggle.addEventListener('change', async function () {
              const id = this.dataset.id;
              const label = document.querySelector('.home-label-' + id);
              const res = await fetch('/admin/product/category/toggle-home/' + id, { method: 'POST' });
              const json = await res.json();
              if (json.success) {
                label.textContent = json.show_in_home ? 'Yes' : 'No';
              } else {
                this.checked = !this.checked;
              }
            });
          });

          // Live table search
          function filterCats() {
            var q = document.getElementById('catSearch').value.toLowerCase();
            var rows = document.querySelectorAll('#catTable tbody tr');
            var count = 0;
            rows.forEach(function (row) {
              var match = row.textContent.toLowerCase().includes(q);
              row.style.display = match ? '' : 'none';
              if (match) count++;
            });
            document.getElementById('catCountLabel').textContent = count + ' items';
            var fc = document.getElementById('catFooterCount');
            if (fc) fc.textContent = 'Showing ' + count + ' of ' + rows.length + ' categories';
          }

          feather.replace();
        </script>

<!-- Override AFTER footer so category media scopes to /uploads/categories/ -->
        <%- include('../partials/footer') %>
<script>
  function loadMedia(page) {
    page = page || 1;
    fetch('/admin/media?page=' + page + '&folder=categories')
      .then(r => r.json())
      .then(data => {
        mediaCurrentPage = data.page       || 1;
        mediaTotalPages  = data.totalPages || 1;
        mediaLoaded      = true;
        renderMedia(data.images || []);
      })
      .catch(() => mediaShowAlert('danger', 'Failed to load media.'));
  }

  function uploadMedia() {
    const input = document.getElementById('mediaUploadInput');
    const files = input.files;
    if (!files.length) return;
    const formData = new FormData();
    for (const f of files) formData.append('files', f);

    fetch('/admin/media/upload/categories', { method: 'POST', body: formData })
      .then(r => r.json())
      .then(data => {
        input.value = '';
        showMediaTab('library');
        mediaLoaded = false;
        loadMedia(1);
        if (data.files && data.files.length) {
          const n = data.files.length;
          setTimeout(() => mediaShowAlert('success', n + ' image' + (n > 1 ? 's' : '') + ' uploaded.'), 300);
          setTimeout(() => {
            const firstUrl = data.files[0].url;
            document.querySelectorAll('#mediaGrid .media-thumb').forEach(div => {
              if (div.dataset.url === firstUrl) {
                _toggleThumb(div, { url: firstUrl, title: data.files[0].original || '', alt: '' });
              }
            });
          }, 500);
        }
      })
      .catch(() => mediaShowAlert('danger', 'Upload failed. Please try again.'));
  }
</script>