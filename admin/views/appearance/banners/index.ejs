<%- include('../../partials/head') %>
<%- include('../../partials/navbar') %>
<%- include('../../partials/sidebar') %>

<div class="page-wrapper">
  <div class="page-breadcrumb">
    <div class="row align-items-center">
      <div class="col-7">
        <h4 class="page-title">Banners</h4>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
            <li class="breadcrumb-item active">Banners</li>
          </ol>
        </nav>
      </div>
      <div class="col-5 text-end">
        <a href="/admin/appearance/banners/add" class="btn-view-product btn-view-product--inline na-view-all-btn">
          <div class="d-flex align-items-center">
            <i data-feather="plus" class="feather-sm me-1"></i> Add Banner
          </div>
        </a>
      </div>
    </div>
  </div>

  <div class="container-fluid">

    <% if (locals.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="feather-sm me-1"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="feather-sm me-1"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">

        <div class="table-responsive">
          <table id="bannersTable" class="table table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th width="70">Image</th>
                <th>Title</th>
                <th>Type</th>
                <th>Link</th>
                <th width="80">Order</th>
                <th width="110">Status</th>
                <th width="110">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (banners && banners.length) { %>
                <% banners.forEach(b => { %>
                  <tr data-id="<%= b.id %>">
                    <td>
                      <% if (b.image_url) { %>
                        <img src="<%= b.image_url %>" alt="<%= b.title || '' %>"
                          class="rounded" width="50" height="50" style="object-fit:cover;" />
                      <% } else { %>
                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                          style="width:50px;height:50px;">
                          <i data-feather="image" class="text-muted feather-sm"></i>
                        </div>
                      <% } %>
                    </td>
                    <td><strong><%= b.title || '—' %></strong></td>
                    <td><span class="badge bg-info text-capitalize"><%= b.type || 'banner' %></span></td>
                    <td>
                      <% if (b.link_url) { %>
                        <a href="<%= b.link_url %>" target="_blank" class="text-muted small">
                          <i data-feather="external-link" style="width:12px;height:12px;"></i>
                          <%= b.link_url.length > 30 ? b.link_url.substring(0,30)+'…' : b.link_url %>
                        </a>
                      <% } else { %>
                        <small class="text-muted">—</small>
                      <% } %>
                    </td>
                    <td><span class="badge bg-light text-dark sort-order-badge"><%= b.sort_order %></span></td>
                    <td>
                      <div class="form-check form-switch mb-0">
                        <input class="form-check-input toggle-status" type="checkbox" role="switch"
                          data-id="<%= b.id %>" <%= b.is_active ? 'checked' : '' %>>
                        <label class="form-check-label status-label-<%= b.id %> small text-muted">
                          <%= b.is_active ? 'Active' : 'Inactive' %>
                        </label>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex gap-1">
                        <a href="/admin/appearance/banners/edit/<%= b.id %>" class="btn btn-sm btn-warning" title="Edit">
                          <i data-feather="edit-2" class="feather-sm"></i>
                        </a>
                        <button class="btn btn-sm btn-danger delete-btn"
                          data-id="<%= b.id %>"
                          data-name="<%= b.title || 'this banner' %>"
                          data-url="/admin/appearance/banners/delete/"
                          data-title="Delete Banner"
                          title="Delete">
                          <i data-feather="trash-2" class="feather-sm"></i>
                        </button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5">
                    <i data-feather="image" style="width:48px;height:48px;" class="text-muted mb-3 d-block mx-auto"></i>
                    <p class="text-muted">No banners yet.</p>
                    <a href="/admin/appearance/banners/add" class="btn btn-primary rounded-pill px-4">Add First Banner</a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>
    </div>

  </div>
</div>

<%- include('../../partials/scripts') %>

<script>
  feather.replace();

  $(document).ready(function () {
    $('#bannersTable').DataTable({
      responsive: true,
      autoWidth: false,
      order: [[4, 'asc']],
      pageLength: 10,
      columnDefs: [
        { orderable: false, targets: [0, 5, 6] }
      ],
      language: {
        emptyTable: 'No banners found',
        info: 'Showing _START_ to _END_ of _TOTAL_ banners',
        infoEmpty: 'Showing 0 to 0 of 0 banners',
        search: 'Search banners:',
        paginate: {
          first: 'First',
          last: 'Last',
          next: 'Next',
          previous: 'Previous'
        }
      }
    });
  });

  // Toggle status
  document.querySelectorAll('.toggle-status').forEach(toggle => {
    toggle.addEventListener('change', async function () {
      const id = this.dataset.id;
      const label = document.querySelector('.status-label-' + id);
      const res = await fetch('/admin/appearance/banners/toggle/' + id, { method: 'POST' });
      const json = await res.json();
      if (json.success) {
        label.textContent = json.is_active ? 'Active' : 'Inactive';
      } else {
        this.checked = !this.checked;
      }
    });
  });
</script>

<%- include('../../partials/footer') %>
