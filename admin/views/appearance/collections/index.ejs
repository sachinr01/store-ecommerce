<%- include('../../partials/head') %>
<%- include('../../partials/navbar') %>
<%- include('../../partials/sidebar') %>

<div class="page-wrapper">
  <div class="page-breadcrumb">
    <div class="row align-items-center">
      <div class="col-7">
        <h4 class="page-title">Our Collection</h4>
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/admin/dashboard">Home</a></li>
            <li class="breadcrumb-item active">Our Collection</li>
          </ol>
        </nav>
      </div>
      <div class="col-5 text-end">
        <div class="btn-group" role="group">
          <a href="/admin/appearance/collections/add?type=main" class="btn btn-primary btn-sm">
            <i data-feather="plus" class="feather-sm me-1"></i> Add Main Panel
          </a>
          <a href="/admin/appearance/collections/add?type=slider" class="btn btn-secondary btn-sm">
            <i data-feather="plus" class="feather-sm me-1"></i> Add Slider Item
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid">

    <% if (locals.success) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i data-feather="check-circle" class="feather-sm me-1"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (locals.error) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i data-feather="alert-circle" class="feather-sm me-1"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Collection Groups -->
    <% if (grouped && grouped.length) { %>
      <% grouped.forEach((group, index) => { %>
        <div class="card mb-4">
          <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <i data-feather="layers" class="feather-icon me-2"></i>
              <h5 class="mb-0"><%= group.main.title || 'Untitled Collection' %></h5>
              <span class="badge bg-light text-dark ms-2"><%= group.main.layout_position || 'left' %></span>
              <span class="badge <%= group.main.is_active ? 'bg-success' : 'bg-secondary' %> ms-2">
                <%= group.main.is_active ? 'Active' : 'Inactive' %>
              </span>
            </div>
            <div>
              <a href="/admin/appearance/collections/edit/<%= group.main.id %>" class="btn btn-light btn-sm me-1">
                <i data-feather="edit-2" class="feather-sm"></i>
              </a>
              <button class="btn btn-danger btn-sm delete-btn"
                data-id="<%= group.main.id %>"
                data-name="<%= group.main.title || 'this main panel' %>"
                data-url="/admin/appearance/collections/delete/"
                data-title="Delete Main Panel">
                <i data-feather="trash-2" class="feather-sm"></i>
              </button>
            </div>
          </div>
          <div class="card-body">
            <div class="row">
              <!-- Main Panel Preview -->
              <div class="col-md-6 mb-3">
                <div class="border rounded p-3">
                  <h6 class="text-muted mb-2">Main Panel (Static)</h6>
                  <% if (group.main.image_url) { %>
                    <img src="<%= group.main.image_url %>" alt="<%= group.main.title %>"
                      class="img-fluid rounded mb-2" style="max-height:200px;object-fit:cover;width:100%;">
                  <% } %>
                  <p class="mb-1"><strong>Order:</strong> <%= group.main.sort_order %></p>
                  <% if (group.main.link_url) { %>
                    <p class="mb-0"><strong>Link:</strong> <a href="<%= group.main.link_url %>" target="_blank"><%= group.main.link_url %></a></p>
                  <% } %>
                </div>
              </div>

              <!-- Slider Items -->
              <div class="col-md-6">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <h6 class="text-muted mb-0">Slider Items (<%= group.sliders.length %>)</h6>
                  <a href="/admin/appearance/collections/add?type=slider" class="btn btn-sm btn-outline-secondary">
                    <i data-feather="plus" class="feather-sm"></i> Add Slider
                  </a>
                </div>

                <% if (group.sliders.length) { %>
                  <div class="list-group">
                    <% group.sliders.forEach(slider => { %>
                      <div class="list-group-item d-flex align-items-center">
                        <% if (slider.image_url) { %>
                          <img src="<%= slider.image_url %>" alt="<%= slider.title %>"
                            class="rounded me-3" style="width:60px;height:60px;object-fit:cover;">
                        <% } else { %>
                          <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                            style="width:60px;height:60px;">
                            <i data-feather="image" class="text-muted"></i>
                          </div>
                        <% } %>
                        <div class="flex-grow-1">
                          <h6 class="mb-0"><%= slider.title || 'Untitled' %></h6>
                          <small class="text-muted">Order: <%= slider.sort_order %></small>
                        </div>
                        <div class="form-check form-switch me-2">
                          <input class="form-check-input toggle-status" type="checkbox" role="switch"
                            data-id="<%= slider.id %>" <%= slider.is_active ? 'checked' : '' %>>
                        </div>
                        <a href="/admin/appearance/collections/edit/<%= slider.id %>" class="btn btn-sm btn-warning me-1">
                          <i data-feather="edit-2" class="feather-sm"></i>
                        </a>
                        <button class="btn btn-sm btn-danger delete-btn"
                          data-id="<%= slider.id %>"
                          data-name="<%= slider.title || 'this slider' %>"
                          data-url="/admin/appearance/collections/delete/"
                          data-title="Delete Slider">
                          <i data-feather="trash-2" class="feather-sm"></i>
                        </button>
                      </div>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="alert alert-info mb-0">
                    <i data-feather="info" class="feather-sm me-1"></i>
                    No slider items yet. Add slider items to rotate on this main panel.
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="card">
        <div class="card-body text-center py-5">
          <i data-feather="layers" style="width:64px;height:64px;" class="text-muted mb-3 d-block mx-auto"></i>
          <h5>No Collections Yet</h5>
          <p class="text-muted">Start by creating a main panel for your collection.</p>
          <a href="/admin/appearance/collections/add?type=main" class="btn btn-primary rounded-pill px-4">
            <i data-feather="plus" class="feather-sm me-1"></i> Add First Main Panel
          </a>
        </div>
      </div>
    <% } %>

    <!-- Orphaned Sliders -->
    <% if (orphans && orphans.length) { %>
      <div class="card border-warning">
        <div class="card-header bg-warning text-dark">
          <i data-feather="alert-triangle" class="feather-sm me-2"></i>
          <strong>Orphaned Slider Items (No Parent)</strong>
        </div>
        <div class="card-body">
          <p class="text-muted">These slider items are not linked to any main panel:</p>
          <div class="list-group">
            <% orphans.forEach(orphan => { %>
              <div class="list-group-item d-flex align-items-center">
                <% if (orphan.image_url) { %>
                  <img src="<%= orphan.image_url %>" alt="<%= orphan.title %>"
                    class="rounded me-3" style="width:60px;height:60px;object-fit:cover;">
                <% } %>
                <div class="flex-grow-1">
                  <h6 class="mb-0"><%= orphan.title || 'Untitled' %></h6>
                  <small class="text-muted">Order: <%= orphan.sort_order %></small>
                </div>
                <a href="/admin/appearance/collections/edit/<%= orphan.id %>" class="btn btn-sm btn-warning me-1">
                  <i data-feather="edit-2" class="feather-sm"></i> Fix
                </a>
                <button class="btn btn-sm btn-danger delete-btn"
                  data-id="<%= orphan.id %>"
                  data-name="<%= orphan.title || 'this slider' %>"
                  data-url="/admin/appearance/collections/delete/"
                  data-title="Delete Slider">
                  <i data-feather="trash-2" class="feather-sm"></i>
                </button>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>

  </div>
</div>

<%- include('../../partials/scripts') %>

<script>
  feather.replace();

  // Toggle status
  document.querySelectorAll('.toggle-status').forEach(toggle => {
    toggle.addEventListener('change', async function () {
      const id = this.dataset.id;
      const res = await fetch('/admin/appearance/collections/toggle/' + id, { method: 'POST' });
      const json = await res.json();
      if (!json.success) {
        this.checked = !this.checked;
        alert('Failed to update status');
      }
    });
  });
</script>

<%- include('../../partials/footer') %>
